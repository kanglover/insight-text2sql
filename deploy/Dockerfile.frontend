# ---------- 1. 构建前端静态资源 ----------
# 用 Debian/glibc 基础镜像（而非 alpine/musl）：vite/rollup/esbuild 的原生二进制在
# musl 下偶发加载/兼容问题，导致 `npm run build` 在 CI 的 alpine 容器里失败；
# 而 ubuntu(glibc) 的 test-frontend 阶段同一条命令能过，故构建阶段统一走 glibc。
FROM node:20-slim AS build

WORKDIR /app

# 接口地址。留空 = 前端用同源相对路径 /api，由 nginx 反代到后端（默认，推荐）。
# 前后端不在同一域名下时，构建时注入后端地址：
#   docker build --build-arg VITE_API_BASE=https://api.example.com ...
# 注意：Vite 环境变量在**构建期**内联进产物，容器启动后再改环境变量无效。
ARG VITE_API_BASE=""
ENV VITE_API_BASE=$VITE_API_BASE

# 先只拷贝依赖清单，命中缓存时跳过整个 npm install
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# ---------- 2. 用 nginx 托管静态资源并反代 /api ----------
FROM nginx:1.27-alpine

# 站点配置：静态托管 + /api 反向代理（含 SSE 支持）
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
