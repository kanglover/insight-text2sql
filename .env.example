# 复制为 .env 后按需修改；只有 LLM_* 是真正需要你填的。
# 不填 LLM_API_KEY 也能跑：LLM_PROVIDER=auto 会自动降级到内置规则引擎。

# ---- 大模型（OpenAI 兼容协议）----
# auto = 有 key 用大模型、失败自动降级；openai = 只用大模型；rule = 只用规则引擎（完全离线）
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# ---- 数据库 ----
# 默认 SQLite（零依赖，演示够用）。Docker 镜像里已经装好了 MySQL 驱动，
# 本地裸跑想切库的话再装可选依赖：pip install -e ".[mysql]"
# DATABASE_URL=sqlite+aiosqlite:///./var/insight.db

# ---- MySQL 部署 ----
# 这一组只在用了 docker-compose.mysql.yml 时生效；
# 基础的 docker-compose.yml 固定用 SQLite，不受这里影响。
# ⚠️ 下面两组必须一致：compose 不支持在默认值里嵌套引用变量，
#    改了 MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE 就要同步改 DATABASE_URL。
MYSQL_ROOT_PASSWORD=Insight_Root_2026
MYSQL_DATABASE=insight
MYSQL_USER=insight
MYSQL_PASSWORD=Insight_2026
# 连接串必须带 ?charset=utf8mb4，否则中文会变成问号
DATABASE_URL=mysql+aiomysql://insight:Insight_2026@mysql:3306/insight?charset=utf8mb4
# 连接池回收秒数，要小于 MySQL 的 wait_timeout（默认 28800）才不会撞上 2006
DB_POOL_RECYCLE=1800

# ---- 问数安全与执行 ----
SQL_ROW_LIMIT=500
SQL_TIMEOUT_SECONDS=15
SQL_MAX_CORRECTION_RETRY=1

# ---- 检索 ----
RECALL_TOP_K=12
RECALL_MAX_TABLES=6

# ---- 其它 ----
# 支持 * 、a.com,b.com 、["a.com"] 三种写法
CORS_ORIGINS=*
