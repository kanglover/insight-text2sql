# 部署到外部 MySQL（云 RDS / 独立服务器 / 另一台机器）时使用
# ----------------------------------------------------------------------------
# 用法：
#   1. 复制为 deploy.env 并填入你的真实地址
#        cp deploy.env.example deploy.env
#   2. 用 --env-file 注入，启动（注意：不要带 docker-compose.mysql.yml，
#      那个覆盖层会再起一个 mysql 容器；外部库时只需基础 compose + 本文件）
#        docker compose --env-file deploy.env -f docker-compose.yml up -d --build
#
# 原理：backend 的 config.py 一旦发现 DB_HOST 被设置，就用 DB_HOST/DB_PORT/
#       DB_USER/DB_PASSWORD/DB_NAME 自动拼出 MySQL 连接串，优先级高于 DATABASE_URL。
#       所以部署时只需要改 DB_HOST（以及账号/库名），不用碰任何代码或 compose 文件。
# ----------------------------------------------------------------------------

# 外部 MySQL 地址：云库域名或内网 IP。不要用 127.0.0.1 / localhost
#（那是容器自己的回环，容器内写 127.0.0.1 连的是容器自己，必然失败）。
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=insight
DB_PASSWORD=change_me_strong_password
DB_NAME=insight

# 可选：如果仍想用完整 DSN（例如 PostgreSQL），把上面 DB_HOST 留空，
# 只在这里写完整连接串即可：
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/insight
